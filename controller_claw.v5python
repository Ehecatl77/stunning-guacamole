{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      General movement\n#\tAuthor:       Ehecatl Mora\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n# \n# ------------------------------------------\n\nfrom vex import *\n\n# General settings\nloop_refresh_time = 20\n\n# Forward and backward variables (Right Stick Up/Down)\nforward_stick = controller_1.axis2\nforward_multiplier = 0.4\nforward_direction = FORWARD\n\n# Variable for change\ndelta = 0.1\n\nmax_fwd_multiplier = 0.95\nmin_fwd_multiplier = 0.40\n\n# Turning and rotation variables (Left Stick Left/Right)\nturn_shift_stick = controller_1.axis4\nturn_multiplier = 0.45\nturn_direction = REVERSE\n\n# Error and safety settings (Deadzone)\nstick_shaking_limit = 5\n\n# Arm motor variables\narm_motor = Motor(Ports.PORT8)\narm_max_rotation = -90\narm_min_rotation = 0\narm_speed = 45\narm_is_down = False\narm_current_position = 0\nstep_degrees = 40\n\n# Claw motor variables\nclaw_motor = Motor(Ports.PORT3)\nclaw_max_rotation = 90\nclaw_min_rotation = 0\nclaw_speed = 50\nclaw_is_open = False\nclaw_current_position = 0\nclaw_step_degrees = 100\n\n# Funcion to increase\ndef increase_multiplier():\n    global forward_multiplier\n    if forward_multiplier < max_fwd_multiplier:\n        forward_multiplier += delta\n        update_screen()\n\n# Funcion to decrease\ndef decrease_multiplier():\n    global forward_multiplier\n    if forward_multiplier > min_fwd_multiplier:\n        forward_multiplier -= delta\n        update_screen()\n\n# Function to lay down\ndef move_arm_down():\n    global arm_is_down, arm_current_position\n    arm_motor.spin_for(FORWARD, step_degrees, DEGREES, arm_speed, PERCENT)\n    arm_current_position -= step_degrees\n\n    if arm_current_position <= arm_max_rotation:\n        arm_current_position = arm_max_rotation\n        arm_is_down = True\n\n    update_screen()\n\n# Function to lift the arm\ndef move_arm_up():\n    global arm_is_down, arm_current_position\n    arm_motor.spin_for(REVERSE, step_degrees, DEGREES, arm_speed, PERCENT)\n    arm_current_position += step_degrees\n\n    if arm_current_position >= arm_min_rotation:\n        arm_current_position = arm_min_rotation\n        arm_is_down = False\n\n    update_screen()\n\n# Function to open claw\ndef open_claw():\n    global claw_is_open, claw_current_position\n    claw_motor.spin_for(FORWARD, claw_step_degrees, DEGREES, claw_speed, PERCENT)\n    claw_current_position += claw_step_degrees\n\n    if claw_current_position >= claw_max_rotation:\n        claw_current_position = claw_max_rotation\n        claw_is_open = True\n\n    update_screen()\n\n# Function to close claw\ndef close_claw():\n    global claw_is_open, claw_current_position\n    claw_motor.spin_for(REVERSE, claw_step_degrees, DEGREES, claw_speed, PERCENT)\n    claw_current_position -= claw_step_degrees\n\n    if claw_current_position <= claw_min_rotation:\n        claw_current_position = claw_min_rotation\n        claw_is_open = False\n\n    update_screen()\n\ndef update_screen():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"forward_multiplier: \", forward_multiplier)\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"arm position: \", arm_current_position)\n    brain.screen.set_cursor(3, 1)\n    brain.screen.print(\"claw position: \", claw_current_position)\n\n# Main function to handle the remote control loop\ndef main():\n\n    controller_1.buttonUp.pressed(increase_multiplier)\n    controller_1.buttonDown.pressed(decrease_multiplier)\n\n    controller_1.buttonLeft.pressed(move_arm_down)\n    controller_1.buttonRight.pressed(move_arm_up)\n\n    controller_1.buttonL1.pressed(open_claw)\n    controller_1.buttonL2.pressed(close_claw)\n\n    update_screen()\n\n    while True:\n        current_forward = forward_stick.position()\n        current_turn = turn_shift_stick.position()\n\n        move_my_robot(\n            current_forward,\n            current_turn,\n            stick_shaking_limit,\n            forward_multiplier,\n            turn_multiplier,\n            forward_direction,\n            turn_direction\n        )\n\n        wait(loop_refresh_time, MSEC)\n\n# Custom function that does the math and spins the wheels\ndef move_my_robot(\n    forward_value,\n    turn_value,\n    stick_error,\n    multiply_forward,\n    multiply_turn,\n    left_side_dir,\n    right_side_dir\n):\n\n    final_forward = forward_value * multiply_forward\n    final_turn = turn_value * multiply_turn\n\n    if abs(final_forward) <= stick_error:\n        final_forward = 0\n\n    if abs(final_turn) <= stick_error:\n        final_turn = 0\n\n    left_wheel_speed = final_forward + final_turn\n    right_wheel_speed = final_forward - final_turn\n\n    LeftMotor.spin(left_side_dir, left_wheel_speed, PERCENT)\n    RightMotor.spin(right_side_dir, right_wheel_speed, PERCENT)\n\n    return\n\nmain()","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}